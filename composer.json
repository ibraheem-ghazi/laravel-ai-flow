{
    "name": "ibraheem-ghazi/laravel-ai-flow",
    "description": "Composable queued AI workflows for Laravel with steps, tasks, structured generation, and progress tracking.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "ai",
        "workflow",
        "queue"
    ],
    "homepage": "https://github.com/ibraheem-ghazi/laravel-ai-flow",
    "support": {
        "issues": "https://github.com/ibraheem-ghazi/laravel-ai-flow/issues",
        "source": "https://github.com/ibraheem-ghazi/laravel-ai-flow"
    },
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "laravel/ai": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0|^13.0",
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "IbraheemGhazi\\LaravelAiFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IbraheemGhazi\\LaravelAiFlow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IbraheemGhazi\\LaravelAiFlow\\AiGenerationServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    }
}
